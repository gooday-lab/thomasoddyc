 {"copy_key":"eyebrow","value_en":"MIS Analyst · Data & Reporting","value_id":"MIS Analyst · Data & Reporting","updated_at":"2026-10-21T16:46:50.941+00:00"}, 
 {"copy_key":"heroTitle","value_en":"I make complex data\nwork clearly.","value_id":"Saya membuat data\nyang kompleks menjadi jelas.","updated_at":"2026-10-21T16:46:50.941+00:00"}, 
 {"copy_key":"heroBody","value_en":"Most of my work starts the same way: a report that eats hours every week. I turn it into something that runs itself.","value_id":"Sebagian besar pekerjaan saya selalu mulai dari hal yang sama: laporan yang memakan waktu berjam-jam setiap minggu. Saya ubah menjadi sistem yang bisa berjalan sendiri.","updated_at":"2026-10-21T16:46:50.941+00:00"}, 
